# Database
# For Docker / PostgreSQL + pgvector:
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/researchpilot
# Fallback database URL for zero-dependency local runs or tests:
# DATABASE_URL=sqlite:///./researchpilot.db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# Task execution mode: "async" (Celery/background task queue) or "in_process" (immediate background thread)
TASK_EXECUTION_MODE=in_process

# Object Storage
# Driver options: "local" (secure local directory) or "s3" (AWS S3 / MinIO)
OBJECT_STORAGE_DRIVER=local
OBJECT_STORAGE_LOCAL_DIR=./storage/documents
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=researchpilot-documents
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_REGION=us-east-1

# AI & Embeddings
# Options: "openai", "gemini", "local" (real ONNX/sentence-transformers), "mock"
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
EMBEDDING_API_KEY=

# Options: "openai", "gemini", "mock"
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# RAG & Chunking
CHUNK_SIZE=600
CHUNK_OVERLAP=100
RETRIEVAL_TOP_K=10
RERANK_TOP_K=5
RRF_K=60

# Security & Auth
AUTH_SECRET=dev-insecure-secret-key-must-change-in-production-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server & CORS
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
